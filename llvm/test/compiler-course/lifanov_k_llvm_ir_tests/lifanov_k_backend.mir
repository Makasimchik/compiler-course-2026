# RUN: llc -load %llvmshlibdir/lifanov_k_backend_BACKEND%pluginext \
# RUN: -run-pass=lifanovk-incdec-fusion %s -o - | FileCheck %s

---

name: lifanovk_basic_folding
body: |
  bb.0:

    ; CHECK: [[R0:%[0-9]+]]:gr32 = ADD32ri [[R0]], 3
    %0:gr32 = INC32r %0, implicit-def $eflags
    %0:gr32 = INC32r %0, implicit-def $eflags
    %0:gr32 = INC32r %0, implicit-def $eflags

    ; CHECK: [[R1:%[0-9]+]]:gr64 = SUB64ri32 [[R1]], 2
    %1:gr64 = DEC64r %1, implicit-def $eflags
    %1:gr64 = DEC64r %1, implicit-def $eflags

    RET 0

---

name: lifanovk_mixed_chain
body: |
  bb.0:

    ; CHECK: [[REG:%[0-9]+]]:gr64 = ADD64ri32 [[REG]], 1
    %2:gr64 = INC64r %2, implicit-def $eflags
    %2:gr64 = INC64r %2, implicit-def $eflags
    %2:gr64 = DEC64r %2, implicit-def $eflags

    RET 0

---

name: lifanovk_register_split
body: |
  bb.0:

    ; CHECK: [[R:%[0-9]+]]:gr32 = ADD32ri [[R]], 2
    ; CHECK: [[TMP:%[0-9]+]]:gr32 = MOV32rr [[R]]
    ; CHECK: [[R2:%[0-9]+]]:gr32 = SUB32ri [[R2]], 1

    %3:gr32 = INC32r %3, implicit-def $eflags
    %3:gr32 = INC32r %3, implicit-def $eflags

    %4:gr32 = MOV32rr %3

    %3:gr32 = DEC32r %3, implicit-def $eflags

    RET 0

---

name: lifanovk_independent_blocks
body: |
  bb.0:

    ; CHECK: [[A:%[0-9]+]]:gr32 = ADD32ri [[A]], 2
    ; CHECK: [[B:%[0-9]+]]:gr32 = SUB32ri [[B]], 2

    %5:gr32 = INC32r %5, implicit-def $eflags
    %5:gr32 = INC32r %5, implicit-def $eflags

    %6:gr32 = DEC32r %6, implicit-def $eflags
    %6:gr32 = DEC32r %6, implicit-def $eflags

    RET 0
