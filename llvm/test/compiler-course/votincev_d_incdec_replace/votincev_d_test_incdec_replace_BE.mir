# RUN: llc -mtriple=x86_64-unknown-linux-gnu -load %p/../../../../build/lib/votincev_d_incdec_replace_BACKEND.so -run-pass=votincev_d_incdec_replace-x86 %s -o - | FileCheck %s

--- |
  define dso_local noundef i32 @_Z1fii(i32 noundef %a, i32 noundef %b) {
  entry:
    %c = alloca i32, align 4
    ret i32 0
  }
  define dso_local void @test_edge_cases() {
  entry:
    ret void
  }
...
---
name:            _Z1fii
alignment:       16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 2, class: gr32 }
  - { id: 21, class: gr32 }
  - { id: 24, class: gr32 }
  - { id: 25, class: gr32 }
  - { id: 31, class: gr32 }
  - { id: 35, class: gr32 }
  - { id: 38, class: gr32 }
  - { id: 39, class: gr32 }
stack:
  - { id: 0, size: 4, alignment: 4 }
body:             |
  bb.0.entry:
    liveins: $edi, $esi
    %2:gr32 = COPY $esi
    %0:gr32 = COPY $edi

    ; ТЕСТ 1: Цепочка INC (3 инструкции)
    ; CHECK-LABEL: name: _Z1fii
    ; CHECK: [[REG1:%[0-9]+]]:gr32 = MOV32rm %stack.0
    ; CHECK-NEXT: [[REG2:%[0-9]+]]:gr32 = ADD32ri [[REG1]], 3,
    ; CHECK-NEXT: MOV32mr %stack.0, 1, $noreg, 0, $noreg, [[REG2]]
    %39:gr32 = MOV32rm %stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %ir.c)
    %38:gr32 = INC32r %39, implicit-def $eflags
    %35:gr32 = INC32r %38, implicit-def $eflags
    %31:gr32 = INC32r %35, implicit-def $eflags
    MOV32mr %stack.0, 1, $noreg, 0, $noreg, %31 :: (store (s32) into %ir.c)

    ; ТЕСТ 2: Цепочка DEC (2 инструкции) -> Ожидаем SUB32ri ..., 2
    ; CHECK: [[REG3:%[0-9]+]]:gr32 = MOV32rm %stack.0
    ; CHECK-NEXT: [[REG4:%[0-9]+]]:gr32 = SUB32ri [[REG3]], 2,
    ; CHECK-NEXT: MOV32mr %stack.0, 1, $noreg, 0, $noreg, [[REG4]]
    %25:gr32 = MOV32rm %stack.0, 1, $noreg, 0, $noreg :: (load (s32) from %ir.c)
    %24:gr32 = DEC32r %25, implicit-def $eflags
    %21:gr32 = DEC32r %24, implicit-def $eflags
    MOV32mr %stack.0, 1, $noreg, 0, $noreg, %21 :: (store (s32) into %ir.c)
    RET64
...
---
name:            test_edge_cases
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
  - { id: 3, class: gr32 }
  - { id: 4, class: gr32 }
  - { id: 5, class: gr32 }
  - { id: 6, class: gr32 }
  - { id: 7, class: gr32 }
  - { id: 8, class: gr32 }
  - { id: 9, class: gr32 }
  - { id: 10, class: gr32 }
  - { id: 11, class: gr32 }
  - { id: 12, class: gr32 }
  - { id: 13, class: gr32 }
  - { id: 14, class: gr32 }
  - { id: 15, class: gr32 }
  - { id: 16, class: gr32 }
body:             |
  bb.0.entry:
    ; ТЕСТ 3: INC + DEC = 0 (Ожидаем COPY)
    ; CHECK-LABEL: name: test_edge_cases
    ; CHECK: [[R1:%[0-9]+]]:gr32 = COPY %0
    %0:gr32 = IMPLICIT_DEF
    %10:gr32 = INC32r %0, implicit-def $eflags
    %1:gr32 = DEC32r %10, implicit-def $eflags

    ; ТЕСТ 4: Параллельные цепочки
    ; CHECK: [[R3:%[0-9]+]]:gr32 = ADD32ri [[R2:%[0-9]+]], 2,
    ; CHECK: [[R5:%[0-9]+]]:gr32 = SUB32ri [[R4:%[0-9]+]], 2,
    %2:gr32 = IMPLICIT_DEF
    %4:gr32 = IMPLICIT_DEF
    %11:gr32 = INC32r %2, implicit-def $eflags
    %12:gr32 = DEC32r %4, implicit-def $eflags
    %3:gr32 = INC32r %11, implicit-def $eflags
    %5:gr32 = DEC32r %12, implicit-def $eflags

    ; ТЕСТ 5: Прерывание цепочки (NOOP)
    ; CHECK: [[R8:%[0-9]+]]:gr32 = ADD32ri [[R6:%[0-9]+]], 3,
    ; CHECK: NOOP
    %6:gr32 = IMPLICIT_DEF
    %13:gr32 = INC32r %6, implicit-def $eflags
    %7:gr32 = INC32r %13, implicit-def $eflags
    NOOP
    %8:gr32 = INC32r %7, implicit-def $eflags

    ; ТЕСТ 6: Смешанная цепочка (INC + INC + DEC = +1)
    ; CHECK: [[R14:%[0-9]+]]:gr32 = ADD32ri [[R9:%[0-9]+]], 1,
    %9:gr32 = IMPLICIT_DEF
    %15:gr32 = INC32r %9, implicit-def $eflags
    %16:gr32 = INC32r %15, implicit-def $eflags
    %14:gr32 = DEC32r %16, implicit-def $eflags
    RET64
...
