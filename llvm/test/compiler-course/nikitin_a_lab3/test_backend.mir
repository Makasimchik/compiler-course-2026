# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:   --load=%llvmshlibdir/nikitin_a_lab3_BACKEND%shlibext \
# RUN:   -run-pass=x86-nullcheck %s -o - | FileCheck %s

# Тест 1: Загрузка из памяти
---
name: test_load
tracksRegLiveness: true
liveins:
  - { reg: '$rdi' }
body: |
  bb.0:
    liveins: $rdi
    %0:gr64 = COPY $rdi
    %1:gr32 = MOV32rm %0, 1, $noreg, 0, $noreg
    $eax = COPY %1
    RET 0, $eax

# CHECK-LABEL: name: test_load
# CHECK: TEST64rr %0, %0
# CHECK: JCC_1 %bb.2, 4
# CHECK: JMP_1 %bb.3
# CHECK: TRAP
# CHECK: MOV32rm %0, 1, $noreg, 0, $noreg

# Тест 2: Запись в память
---
name: test_store
tracksRegLiveness: true
liveins:
  - { reg: '$rdi' }
  - { reg: '$esi' }
body: |
  bb.0:
    liveins: $rdi, $esi
    %0:gr64 = COPY $rdi
    %1:gr32 = COPY $esi
    MOV32mr %0, 1, $noreg, 0, $noreg, %1
    RET 0

# CHECK-LABEL: name: test_store
# CHECK: TEST64rr %0, %0
# CHECK: JCC_1 %bb.2, 4
# CHECK: JMP_1 %bb.3
# CHECK: TRAP
# CHECK: MOV32mr %0, 1, $noreg, 0, $noreg, %1

# Тест 3: 64-битная загрузка
---
name: test_load64
tracksRegLiveness: true
liveins:
  - { reg: '$rdi' }
body: |
  bb.0:
    liveins: $rdi
    %0:gr64 = COPY $rdi
    %1:gr64 = MOV64rm %0, 1, $noreg, 0, $noreg
    $rax = COPY %1
    RET 0, $rax

# CHECK-LABEL: name: test_load64
# CHECK: TEST64rr %0, %0
# CHECK: JCC_1 %bb.2, 4
# CHECK: JMP_1 %bb.3
# CHECK: TRAP
# CHECK: MOV64rm %0, 1, $noreg, 0, $noreg

# Тест 4: Без разыменования
---
name: test_no_deref
tracksRegLiveness: true
liveins:
  - { reg: '$edi' }
  - { reg: '$esi' }
body: |
  bb.0:
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = ADD32rr %0, %1, implicit-def $eflags
    $eax = COPY %2
    RET 0, $eax

# CHECK-LABEL: name: test_no_deref
# CHECK-NOT: TEST64rr
# CHECK-NOT: JCC_1
# CHECK-NOT: TRAP

# Тест 5: Доступ со смещением
---
name: test_offset
tracksRegLiveness: true
liveins:
  - { reg: '$rdi' }
body: |
  bb.0:
    liveins: $rdi
    %0:gr64 = COPY $rdi
    %1:gr32 = MOV32rm %0, 1, $noreg, 8, $noreg
    $eax = COPY %1
    RET 0, $eax

# CHECK-LABEL: name: test_offset
# CHECK: TEST64rr %0, %0
# CHECK: JCC_1 %bb.2, 4
# CHECK: JMP_1 %bb.3
# CHECK: TRAP
# CHECK: MOV32rm %0, 1, $noreg, 8, $noreg

