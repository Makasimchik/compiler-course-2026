# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/krykov_e_check_null_BACKEND%shlibext \
# RUN: -run-pass=null-check-x86 %s -o - | FileCheck %s


--- |
  define dso_local i32 @foo(i32* noundef %p) {
  entry:
    %0 = load i32, i32* %p
    ret i32 %0
  }

  define dso_local void @set(i32* noundef %p, i32 noundef %x) {
  entry:
    store i32 %x, i32* %p
    ret void
  }

  define dso_local i32 @load_via_rsi(i32 noundef %dummy, i32* noundef %p) {
  entry:
    %0 = load i32, i32* %p
    ret i32 %0
  }

...
---
# CHECK: name:            foo
name:            foo
alignment:       16
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true

registers:
  - { id: 0, class: gr64 }

liveins:
  - { reg: '$rdi', virtual-reg: '%0' }

body: |
  bb.0:
    liveins: $rdi

    ; CHECK: TEST64rr $rdi, $rdi
    ; CHECK-NEXT: JCC_1 %bb.{{[0-9]+}}, 4
    ; CHECK-NEXT: JMP_1 %bb.{{[0-9]+}}
    ; CHECK:      RET64
    ; CHECK:      bb.{{[0-9]+}}:
    ; CHECK:      MOV32rm
    ; CHECK:      RET64
    %1:gr32 = MOV32rm renamable $rdi, 1, $noreg, 0, $noreg
    RET64 %1

...
---
# CHECK: name:            set
name:            set
alignment:       16
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true

registers:
  - { id: 0, class: gr64 }
  - { id: 1, class: gr32 }

liveins:
  - { reg: '$rdi', virtual-reg: '%0' }
  - { reg: '$esi', virtual-reg: '%1' }

body: |
  bb.0:
    liveins: $rdi, $esi

    ; CHECK:      TEST64rr $rdi, $rdi
    ; CHECK-NEXT: JCC_1 %bb.{{[0-9]+}}, 4
    ; CHECK-NEXT: JMP_1 %bb.{{[0-9]+}}
    ; CHECK:      bb.{{[0-9]+}}:
    ; CHECK:      RET64
    ; CHECK:      bb.{{[0-9]+}}:
    ; CHECK:      MOV32mr
    ; CHECK:      RET64
    MOV32mr renamable $rdi, 1, $noreg, 0, $noreg, renamable $esi
    RET64

...
---
# CHECK: name:            load_via_rsi
name:            load_via_rsi
alignment:       16
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true

registers:
  - { id: 0, class: gr64 }

liveins:
  - { reg: '$rsi', virtual-reg: '%0' }

body: |
  bb.0:
    liveins: $rsi

    ; CHECK:      TEST64rr $rsi, $rsi
    ; CHECK-NEXT: JCC_1 %bb.{{[0-9]+}}, 4
    ; CHECK-NEXT: JMP_1 %bb.{{[0-9]+}}
    ; CHECK:      bb.{{[0-9]+}}:
    ; CHECK:      RET64
    ; CHECK:      bb.{{[0-9]+}}:
    ; CHECK:      MOV32rm
    ; CHECK:      RET64
    %1:gr32 = MOV32rm renamable $rsi, 1, $noreg, 0, $noreg
    RET64 %1

...
