# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/morozova_s_lab3_BACKEND%shlibext -run-pass=inlining %s -o - | FileCheck %s

--- |
  define i32 @add(i32 %a, i32 %b) {
    %sum = add i32 %a, %b
    ret i32 %sum
  }

  define i32 @small(i32 %x) {
    %a = add i32 %x, 1
    %b = add i32 %a, 2
    %c = add i32 %b, 3
    ret i32 %c
  }

  define i32 @large(i32 %x) {
    %1 = add i32 %x, 1
    %2 = add i32 %1, 2
    %3 = add i32 %2, 3
    %4 = add i32 %3, 4
    %5 = add i32 %4, 5
    %6 = add i32 %5, 6
    %7 = add i32 %6, 7
    %8 = add i32 %7, 8
    %9 = add i32 %8, 9
    %10 = add i32 %9, 10
    %11 = add i32 %10, 11
    %12 = add i32 %11, 12
    %13 = add i32 %12, 13
    %14 = add i32 %13, 14
    %15 = add i32 %14, 15
    %16 = add i32 %15, 16
    ret i32 %16
  }

  define i32 @factorial(i32 %n) {
    %cmp = icmp sle i32 %n, 1
    br i1 %cmp, label %end, label %rec
  end:
    ret i32 1
  rec:
    %sub = sub i32 %n, 1
    %call = call i32 @factorial(i32 %sub)
    %mul = mul i32 %n, %call
    ret i32 %mul
  }

  define i32 @main() {
    %r1 = call i32 @add(i32 10, i32 20)
    %r2 = call i32 @small(i32 1)
    %r3 = call i32 @large(i32 3)
    %r4 = call i32 @factorial(i32 4)
    %res = add i32 %r1, %r2
    %res2 = add i32 %res, %r3
    %final = add i32 %res2, %r4
    ret i32 %final
  }

...

# CHECK-LABEL: name: main
name: main
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK: %0:gr32 = MOV32ri 10
    ; CHECK: %1:gr32 = MOV32ri 20
    ; CHECK: %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags

    ; CHECK: %3:gr32 = MOV32ri 1
    ; CHECK: %4:gr32 = ADD32ri %3, 1, implicit-def dead $eflags
    ; CHECK: %5:gr32 = ADD32ri %4, 2, implicit-def dead $eflags
    ; CHECK: %6:gr32 = ADD32ri %5, 3, implicit-def dead $eflags

    ; CHECK: %7:gr32 = MOV32ri 3
    ; CHECK: %8:gr32 = ADD32ri %7, 1, implicit-def dead $eflags
    ; CHECK: %9:gr32 = ADD32ri %8, 2, implicit-def dead $eflags
    ; CHECK: %10:gr32 = ADD32ri %9, 3, implicit-def dead $eflags
    ; CHECK: %11:gr32 = ADD32ri %10, 4, implicit-def dead $eflags
    ; CHECK: %12:gr32 = ADD32ri %11, 5, implicit-def dead $eflags
    ; CHECK: %13:gr32 = ADD32ri %12, 6, implicit-def dead $eflags
    ; CHECK: %14:gr32 = ADD32ri %13, 7, implicit-def dead $eflags
    ; CHECK: %15:gr32 = ADD32ri %14, 8, implicit-def dead $eflags
    ; CHECK: %16:gr32 = ADD32ri %15, 9, implicit-def dead $eflags
    ; CHECK: %17:gr32 = ADD32ri %16, 10, implicit-def dead $eflags
    ; CHECK: %18:gr32 = ADD32ri %17, 11, implicit-def dead $eflags
    ; CHECK: %19:gr32 = ADD32ri %18, 12, implicit-def dead $eflags
    ; CHECK: %20:gr32 = ADD32ri %19, 13, implicit-def dead $eflags
    ; CHECK: %21:gr32 = ADD32ri %20, 14, implicit-def dead $eflags
    ; CHECK: %22:gr32 = ADD32ri %21, 15, implicit-def dead $eflags
    ; CHECK: %23:gr32 = ADD32ri %22, 16, implicit-def dead $eflags

    ; CHECK: %24:gr32 = MOV32ri 4
    ; CHECK: CALL64pcrel32 @factorial
    ; CHECK: %25:gr32 = COPY $eax

    %0:gr32 = MOV32ri 10
    %1:gr32 = MOV32ri 20
    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags

    %3:gr32 = MOV32ri 1
    %4:gr32 = ADD32ri %3, 1, implicit-def dead $eflags
    %5:gr32 = ADD32ri %4, 2, implicit-def dead $eflags
    %6:gr32 = ADD32ri %5, 3, implicit-def dead $eflags

    %7:gr32 = MOV32ri 3
    %8:gr32 = ADD32ri %7, 1, implicit-def dead $eflags
    %9:gr32 = ADD32ri %8, 2, implicit-def dead $eflags
    %10:gr32 = ADD32ri %9, 3, implicit-def dead $eflags
    %11:gr32 = ADD32ri %10, 4, implicit-def dead $eflags
    %12:gr32 = ADD32ri %11, 5, implicit-def dead $eflags
    %13:gr32 = ADD32ri %12, 6, implicit-def dead $eflags
    %14:gr32 = ADD32ri %13, 7, implicit-def dead $eflags
    %15:gr32 = ADD32ri %14, 8, implicit-def dead $eflags
    %16:gr32 = ADD32ri %15, 9, implicit-def dead $eflags
    %17:gr32 = ADD32ri %16, 10, implicit-def dead $eflags
    %18:gr32 = ADD32ri %17, 11, implicit-def dead $eflags
    %19:gr32 = ADD32ri %18, 12, implicit-def dead $eflags
    %20:gr32 = ADD32ri %19, 13, implicit-def dead $eflags
    %21:gr32 = ADD32ri %20, 14, implicit-def dead $eflags
    %22:gr32 = ADD32ri %21, 15, implicit-def dead $eflags
    %23:gr32 = ADD32ri %22, 16, implicit-def dead $eflags

    %24:gr32 = MOV32ri 4
    CALL64pcrel32 @factorial, csr_64, implicit $sp, implicit $ssp, implicit-def $eax
    %25:gr32 = COPY $eax

    %26:gr32 = ADD32rr %2, %6, implicit-def dead $eflags
    %27:gr32 = ADD32rr %26, %23, implicit-def dead $eflags
    %28:gr32 = ADD32rr %27, %25, implicit-def dead $eflags
    $eax = COPY %28
    RET 0, $eax