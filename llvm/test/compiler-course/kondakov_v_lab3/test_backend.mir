    $eax = MOV32ri 1
    $ebx = MOV32ri 2
    $ecx = MOV32ri 5
    $edx = MOV32ri 1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $eax, $ebx, $ecx, $edx

    $eax = ADD32rr killed $eax, $ebx, implicit-def dead $eflags
    $ecx = SUB32rr killed $ecx, $edx, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit killed $eflags

  bb.2:
    RET 0
...

---
# CHECK-LABEL: name: zero_trip
# CHECK: bb.1:
# CHECK: $eax = ADD32rr
# CHECK: JCC_1 %bb.1, 5
name: zero_trip
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)

    $eax = MOV32ri 7
    $ebx = MOV32ri 4
    $ecx = MOV32ri 0
    $edx = MOV32ri 1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $eax, $ebx, $ecx, $edx

    $eax = ADD32rr killed $eax, $ebx, implicit-def dead $eflags
    $ecx = SUB32rr killed $ecx, $edx, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit killed $eflags

  bb.2:
    RET 0
...

---
# CHECK-LABEL: name: non_self_latch
# CHECK: bb.1:
# CHECK-COUNT-1: $eax = ADD32rr
# CHECK: bb.2:
# CHECK: JCC_1 %bb.1, 5
name: non_self_latch
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)

    $eax = MOV32ri 9
    $ebx = MOV32ri 2
    $ecx = MOV32ri 3
    $edx = MOV32ri 1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $eax, $ebx, $ecx, $edx

    $eax = ADD32rr killed $eax, $ebx, implicit-def dead $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.1(0x40000000), %bb.3(0x40000000)
    liveins: $ecx, $edx

    $ecx = SUB32rr killed $ecx, $edx, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit killed $eflags

  bb.3:
    RET 0
...
