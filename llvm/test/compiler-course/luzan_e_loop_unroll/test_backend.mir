# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/luzan_e_loop_unroll_BACKEND%shlibext \
# RUN:     -run-pass=luzan_e_loop_unroll-x86 \
# RUN:     %s -o - | FileCheck %s


--- |
  ; ModuleID = 'test_opt.ll'
  source_filename = "test.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-pc-linux-gnu"
  
  ; Function Attrs: noinline nounwind optnone uwtable
  define dso_local void @func(i32 noundef %0, i32 noundef %1) #0 {
    %3 = alloca i32, align 4
    %4 = alloca i32, align 4
    store i32 %0, ptr %3, align 4
    store i32 %1, ptr %4, align 4
    ret void
  }
  
  define dso_local void @nested_loop(i32 noundef %0) {
    br label %2
  
  2:                                                ; preds = %8, %1
    %.01 = phi i32 [ 0, %1 ], [ %9, %8 ]
    %3 = icmp slt i32 %.01, 2
    br i1 %3, label %.preheader, label %10
  
  .preheader:                                       ; preds = %2
    br label %4
  
  4:                                                ; preds = %6, %.preheader
    %.0 = phi i32 [ %7, %6 ], [ 0, %.preheader ]
    %5 = icmp slt i32 %.0, 4
    br i1 %5, label %6, label %8
  
  6:                                                ; preds = %4
    call void @func(i32 noundef %.0, i32 noundef %.01)
    %7 = add nsw i32 %.0, 1
    br label %4, !llvm.loop !6
  
  8:                                                ; preds = %4
    %9 = add nsw i32 %.01, 1
    br label %2, !llvm.loop !8
  
  10:                                               ; preds = %2
    ret void
  }
  
  define dso_local i32 @ultra_nested(i32 noundef %0) {
    %2 = alloca i32, align 4
    store volatile i32 2, ptr %2, align 4
    br label %3
  
  3:                                                ; preds = %15, %1
    %.01 = phi i32 [ 0, %1 ], [ %16, %15 ]
    %4 = icmp slt i32 %.01, 2
    br i1 %4, label %.preheader3, label %17
  
  .preheader3:                                      ; preds = %3
    br label %5
  
  5:                                                ; preds = %13, %.preheader3
    %.02 = phi i32 [ %14, %13 ], [ 0, %.preheader3 ]
    %6 = icmp slt i32 %.02, 3
    br i1 %6, label %.preheader, label %15
  
  .preheader:                                       ; preds = %5
    br label %7
  
  7:                                                ; preds = %9, %.preheader
    %.0 = phi i32 [ %12, %9 ], [ 0, %.preheader ]
    %8 = icmp slt i32 %.0, 2
    br i1 %8, label %9, label %13
  
  9:                                                ; preds = %7
    %10 = load volatile i32, ptr %2, align 4
    %11 = mul nsw i32 %10, 2
    store volatile i32 %11, ptr %2, align 4
    %12 = add nsw i32 %.0, 1
    br label %7, !llvm.loop !9
  
  13:                                               ; preds = %7
    %14 = add nsw i32 %.02, 1
    br label %5, !llvm.loop !10
  
  15:                                               ; preds = %5
    %16 = add nsw i32 %.01, 1
    br label %3, !llvm.loop !11
  
  17:                                               ; preds = %3
    %18 = load volatile i32, ptr %2, align 4
    ret i32 %18
  }
  
  define dso_local void @simp_nested(i32 noundef %0) {
    br label %2
  
  2:                                                ; preds = %8, %1
    %.01 = phi i32 [ 0, %1 ], [ %9, %8 ]
    %3 = icmp slt i32 %.01, 2
    br i1 %3, label %.preheader, label %10
  
  .preheader:                                       ; preds = %2
    br label %4
  
  4:                                                ; preds = %6, %.preheader
    %.0 = phi i32 [ %7, %6 ], [ 0, %.preheader ]
    %5 = icmp slt i32 %.0, 3
    br i1 %5, label %6, label %8
  
  6:                                                ; preds = %4
    %7 = add nsw i32 %.0, 1
    br label %4, !llvm.loop !12
  
  8:                                                ; preds = %4
    %9 = add nsw i32 %.01, 1
    br label %2, !llvm.loop !13
  
  10:                                               ; preds = %2
    ret void
  }
  
  define dso_local void @simple_loop(i32 noundef %0) {
    br label %2
  
  2:                                                ; preds = %4, %1
    %.0 = phi i32 [ 0, %1 ], [ %5, %4 ]
    %3 = icmp slt i32 %.0, 4
    br i1 %3, label %4, label %6
  
  4:                                                ; preds = %2
    call void @func(i32 noundef %.0, i32 noundef %.0)
    %5 = add nsw i32 %.0, 1
    br label %2, !llvm.loop !14
  
  6:                                                ; preds = %2
    ret void
  }
  
  define dso_local void @loop(i32 noundef %0) {
    br label %2
  
  2:                                                ; preds = %4, %1
    %.0 = phi i32 [ 0, %1 ], [ %5, %4 ]
    %3 = icmp slt i32 %.0, 4
    br i1 %3, label %4, label %6
  
  4:                                                ; preds = %2
    %5 = add nsw i32 %.0, 1
    br label %2, !llvm.loop !15
  
  6:                                                ; preds = %2
    ret void
  }
  
  define dso_local void @dyn_loop(i32 noundef %0) {
    br label %2
  
  2:                                                ; preds = %4, %1
    %.0 = phi i32 [ 0, %1 ], [ %5, %4 ]
    %3 = icmp slt i32 %.0, %0
    br i1 %3, label %4, label %6
  
  4:                                                ; preds = %2
    %5 = add nsw i32 %.0, 1
    br label %2, !llvm.loop !16
  
  6:                                                ; preds = %2
    ret void
  }
  
  attributes #0 = { noinline nounwind optnone uwtable "frame-pointer"="all" "min-legal-vector-width"="0" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="x86-64" "target-features"="+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87" "tune-cpu"="generic" }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 2}
  !5 = !{!"Debian clang version 19.1.7 (3+b1)"}
  !6 = distinct !{!6, !7}
  !7 = !{!"llvm.loop.mustprogress"}
  !8 = distinct !{!8, !7}
  !9 = distinct !{!9, !7}
  !10 = distinct !{!10, !7}
  !11 = distinct !{!11, !7}
  !12 = distinct !{!12, !7}
  !13 = distinct !{!13, !7}
  !14 = distinct !{!14, !7}
  !15 = distinct !{!15, !7}
  !16 = distinct !{!16, !7}
...
---
name:            func
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 4, alignment: 4, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: '', type: default, offset: 0, size: 4, alignment: 4, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0 (%ir-block.2):
    liveins: $edi, $esi
  
    %3:gr32 = COPY $esi
    %1:gr32 = COPY $edi
    MOV32mr %stack.0, 1, $noreg, 0, $noreg, %1 :: (store (s32) into %ir.3)
    MOV32mr %stack.1, 1, $noreg, 0, $noreg, %3 :: (store (s32) into %ir.4)
    RET64
...
---
# CHECK-LABEL: name: nested_loop 
# CHECK-COUNT-8: CALL64pcrel32
# CHECK-NOT: CALL64pcrel32
name:            nested_loop
frameInfo:
  adjustsStack: true
  hasCalls:     true
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x80000000)
  
    %9:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.2):
    successors: %bb.2(0x7c000000), %bb.6(0x04000000)
  
    CMP32ri %9, 1, implicit-def $eflags
    JCC_1 %bb.6, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    %10:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.3 (%ir-block.4):
    successors: %bb.4(0x7c000000), %bb.5(0x04000000)
  
    CMP32ri %10, 3, implicit-def $eflags
    JCC_1 %bb.5, 15, implicit killed $eflags
    JMP_1 %bb.4
  
  bb.4 (%ir-block.6):
    successors: %bb.3(0x80000000)
  
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %10
    $esi = COPY %9
    CALL64pcrel32 @func, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit killed $esi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %10:gr32 = nsw INC32r %10, implicit-def dead $eflags
    JMP_1 %bb.3
  
  bb.5 (%ir-block.8):
    successors: %bb.1(0x80000000)
  
    %9:gr32 = nsw INC32r %9, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.6 (%ir-block.10):
    RET 0
...
---
# CHECK-LABEL: name: ultra_nested
# CHECK-COUNT-12: SHL32mi
# CHECK-NOT: SHL32mi
name:            ultra_nested
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 4, alignment: 4, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x80000000)
  
    MOV32mi %stack.0, 1, $noreg, 0, $noreg, 2 :: (volatile store (s32) into %ir.2)
    %14:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.3):
    successors: %bb.2(0x7c000000), %bb.9(0x04000000)
  
    CMP32ri %14, 1, implicit-def $eflags
    JCC_1 %bb.9, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2..preheader3:
    successors: %bb.3(0x80000000)
  
    %15:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.3 (%ir-block.5):
    successors: %bb.4(0x7c000000), %bb.8(0x04000000)
  
    CMP32ri %15, 2, implicit-def $eflags
    JCC_1 %bb.8, 15, implicit killed $eflags
    JMP_1 %bb.4
  
  bb.4..preheader:
    successors: %bb.5(0x80000000)
  
    %16:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.5 (%ir-block.7):
    successors: %bb.6(0x7c000000), %bb.7(0x04000000)
  
    CMP32ri %16, 1, implicit-def $eflags
    JCC_1 %bb.7, 15, implicit killed $eflags
    JMP_1 %bb.6
  
  bb.6 (%ir-block.9):
    successors: %bb.5(0x80000000)
  
    SHL32mi %stack.0, 1, $noreg, 0, $noreg, 1, implicit-def dead $eflags :: (volatile store (s32) into %ir.2), (volatile dereferenceable load (s32) from %ir.2)
    %16:gr32 = nsw INC32r %16, implicit-def dead $eflags
    JMP_1 %bb.5
  
  bb.7 (%ir-block.13):
    successors: %bb.3(0x80000000)
  
    %15:gr32 = nsw INC32r %15, implicit-def dead $eflags
    JMP_1 %bb.3
  
  bb.8 (%ir-block.15):
    successors: %bb.1(0x80000000)
  
    %14:gr32 = nsw INC32r %14, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.9 (%ir-block.17):
    %9:gr32 = MOV32rm %stack.0, 1, $noreg, 0, $noreg :: (volatile dereferenceable load (s32) from %ir.2)
    $eax = COPY %9
    RET 0, killed $eax
...
---
# CHECK-LABEL: name: simp_nested
# CHECK-COUNT-8: CMP32ri
# CHECK-NOT: CMP32ri
name:            simp_nested
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x80000000)
  
    %9:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.2):
    successors: %bb.2(0x7c000000), %bb.6(0x04000000)
  
    CMP32ri %9, 1, implicit-def $eflags
    JCC_1 %bb.6, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    %10:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.3 (%ir-block.4):
    successors: %bb.4(0x7c000000), %bb.5(0x04000000)
  
    CMP32ri %10, 2, implicit-def $eflags
    JCC_1 %bb.5, 15, implicit killed $eflags
    JMP_1 %bb.4
  
  bb.4 (%ir-block.6):
    successors: %bb.3(0x80000000)
  
    %10:gr32 = nsw INC32r %10, implicit-def dead $eflags
    JMP_1 %bb.3
  
  bb.5 (%ir-block.8):
    successors: %bb.1(0x80000000)
  
    %9:gr32 = nsw INC32r %9, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.6 (%ir-block.10):
    RET 0
...
---
# CHECK-LABEL: name: simple_loop
# CHECK-COUNT-4: CALL64pcrel32
# CHECK-NOT: CALL64pcrel32
name:            simple_loop
frameInfo:
  adjustsStack: true
  hasCalls:     true
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x80000000)
  
    %5:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.2):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    CMP32ri %5, 3, implicit-def $eflags
    JCC_1 %bb.3, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2 (%ir-block.4):
    successors: %bb.1(0x80000000)
  
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %5
    $esi = COPY %5
    CALL64pcrel32 @func, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit killed $esi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %5:gr32 = nsw INC32r %5, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.3 (%ir-block.6):
    RET 0
...
---
# CHECK-LABEL: name: loop
# CHECK-COUNT-4: CMP32ri
# CHECK-NOT: CMP32ri
name:            loop
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x80000000)
  
    %5:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.2):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    CMP32ri %5, 3, implicit-def $eflags
    JCC_1 %bb.3, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2 (%ir-block.4):
    successors: %bb.1(0x80000000)
  
    %5:gr32 = nsw INC32r %5, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.3 (%ir-block.6):
    RET 0
...
---
# CHECK-LABEL: name: dyn_loop
# CHECK-COUNT-1: CMP32rr
# CHECK-NOT: CMP32rr
name:            dyn_loop
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x80000000)
    liveins: $edi
  
    %2:gr32 = COPY $edi
    %5:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.2):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    CMP32rr %5, %2, implicit-def $eflags
    JCC_1 %bb.3, 13, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2 (%ir-block.4):
    successors: %bb.1(0x80000000)
  
    %5:gr32 = nsw INC32r %5, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.3 (%ir-block.6):
    RET 0
...
