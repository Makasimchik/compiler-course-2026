# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/example_BACKEND%shlibext \
# RUN:     -run-pass=example-x86 \
# RUN:     %s -o - | FileCheck %s

--- |
  define void @small_loop() local_unnamed_addr {
  entry:   br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
    %i.next = add i32 %i, 1
    %cond = icmp slt i32 %i.next, 4
    br i1 %cond, label %loop, label %exit
  exit:    ret void
  }

  define void @nested_loop() local_unnamed_addr {
  outer_entry:  br label %outer_loop
  outer_loop:
    %j = phi i32 [ 0, %outer_entry ], [ %j.next, %outer_latch ]
    br label %inner_loop
  inner_loop:
    %i = phi i32 [ 0, %outer_loop ], [ %i.next, %inner_loop ]
    %i.next = add i32 %i, 1
    %icond = icmp slt i32 %i.next, 3
    br i1 %icond, label %inner_loop, label %outer_latch
  outer_latch:
    %j.next = add i32 %j, 1
    %jcond = icmp slt i32 %j.next, 2
    br i1 %jcond, label %outer_loop, label %outer_exit
  outer_exit:   ret void
  }

  define void @too_large_loop() local_unnamed_addr {
  entry:   br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
    %i.next = add i32 %i, 1
    %cond = icmp slt i32 %i.next, 8
    br i1 %cond, label %loop, label %exit
  exit:    ret void
  }

---
name:            small_loop
tracksRegLiveness: false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $eax = MOV32ri 0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    TEST32rr $eax, $eax, implicit-def dead $eflags
    $eax = ADD32ri8 $eax, 1, implicit-def dead $eflags
    CMP32ri8 $eax, 4, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET64

# CHECK-LABEL: name: small_loop
# CHECK-COUNT-1: TEST32rr
# CHECK: $eax = ADD32ri8 $eax, 1

---
name:            nested_loop
tracksRegLiveness: false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $eax = MOV32ri 0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x80000000)
    TEST32rr $eax, $eax, implicit-def dead $eflags
    $ecx = MOV32ri 0
    JMP_1 %bb.2

  bb.2:
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)
    $edx = MOV32rr $ecx
    $ecx = ADD32ri8 $ecx, 1, implicit-def dead $eflags
    CMP32ri8 $ecx, 3, implicit-def $eflags
    JCC_1 %bb.3, 13, implicit killed $eflags
    JMP_1 %bb.2

  bb.3:
    successors: %bb.4(0x04000000), %bb.1(0x7c000000)
    $eax = ADD32ri8 $eax, 1, implicit-def dead $eflags
    CMP32ri8 $eax, 2, implicit-def $eflags
    JCC_1 %bb.4, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.4:
    RET64

# CHECK-LABEL: name: nested_loop
# CHECK-COUNT-1: TEST32rr
# CHECK-COUNT-1: MOV32rr
# CHECK: $ecx = ADD32ri8 $ecx, 1
# CHECK: $eax = ADD32ri8 $eax, 1

---
name:            too_large_loop
tracksRegLiveness: false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $eax = MOV32ri 0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $edx = MOV32rr $eax
    $eax = ADD32ri8 $eax, 1, implicit-def dead $eflags
    CMP32ri8 $eax, 8, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET64

# CHECK-LABEL: name: too_large_loop
# CHECK-COUNT-1: MOV32rr
# CHECK: $eax = ADD32ri8 $eax, 1