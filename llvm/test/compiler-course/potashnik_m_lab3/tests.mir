# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/potashnik_m_lab3_BACKEND%shlibext \
# RUN:     -run-pass=PotashnikLoopUnroll \
# RUN:     %s -o - | FileCheck %s

--- |
  target triple = "x86_64-pc-linux-gnu"

  define void @foo(i32) { ret void }
  define void @test_no_loop() { ret void }
  define void @test_trip4() { ret void }
  define void @test_trip5() { ret void }
  define void @test_trip7() { ret void }
  define void @test_trip1025() { ret void }
  define void @test_trip10() { ret void }
  define void @test_trip20() { ret void }
  define void @test_complex() { ret void }
...
---
name:            foo
frameInfo:
  adjustsStack:    false
body:            |
  bb.0:
    RET 0
...

# Тест 0. Без циклов
# CHECK-LABEL: name: test_no_loop
# CHECK: RET 0
---
name:            test_no_loop
frameInfo:
  adjustsStack:    false
body:            |
  bb.0:
    RET 0
...

# 4 iteration loop
# CHECK-LABEL: name: test_trip4
# CHECK-COUNT-4: CALL64pcrel32 @foo
# CHECK: RET 0
---
name:            test_trip4
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:   ; header/latch/exiting
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 4, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# 5 iteration loop
# CHECK-LABEL: name: test_trip5
# CHECK-COUNT-5: CALL64pcrel32 @foo
# CHECK: RET 0
---
name:            test_trip5
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 5, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# 7 iteration loop (no unrolling)
# CHECK-LABEL: name: test_trip7
# CHECK:      CALL64pcrel32 @foo
# CHECK-NOT:  CALL64pcrel32 @foo
# CHECK:      JMP_1
---
name:            test_trip7
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 7, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# trip 1025 > 1024 (no unrolling)
# CHECK-LABEL: name: test_trip1025
# CHECK:      CALL64pcrel32 @foo
# CHECK-NOT:  CALL64pcrel32 @foo
# CHECK:      JMP_1
---
name:            test_trip1025
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 1025, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# 10 iteration loop
# CHECK-LABEL: name: test_trip10
# CHECK-COUNT-5: CALL64pcrel32 @foo
# CHECK: RET 0
---
name:            test_trip10
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 10, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# 20 iteration loop
# CHECK-LABEL: name: test_trip20
# CHECK-COUNT-5: CALL64pcrel32 @foo
# CHECK: RET 0
---
name:            test_trip20
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
