# RUN: llc -mtriple x86_64-unknown-linux-gnu -load=%llvmshlibdir/titaev_m_lab3_BACKEND%shlibext -run-pass=example-x86 %s -o - | FileCheck %s

--- |
  source_filename = "titaev_test_suite.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

  define void @callee_small() { ret void }
  define void @callee_limit_26() { ret void }
  define void @test_entry() { ret void }
  define void @recursive_func() { ret void }
  define void @symbol_test() { ret void }
  define void @extra_filler_1() { ret void }
  define void @extra_filler_2() { ret void }
...
---
name:            callee_small
tracksRegLiveness: true
body:             |
  bb.0:
    $eax = MOV32ri 42
    $ebx = MOV32ri 24
    RET64
---
name:            callee_limit_26
tracksRegLiveness: true
body:             |
  bb.0:
    $eax = MOV32ri 1
    $eax = MOV32ri 2
    $eax = MOV32ri 3
    $eax = MOV32ri 4
    $eax = MOV32ri 5
    $eax = MOV32ri 6
    $eax = MOV32ri 7
    $eax = MOV32ri 8
    $eax = MOV32ri 9
    $eax = MOV32ri 10
    $eax = MOV32ri 11
    $eax = MOV32ri 12
    $eax = MOV32ri 13
    $eax = MOV32ri 14
    $eax = MOV32ri 15
    $eax = MOV32ri 16
    $eax = MOV32ri 17
    $eax = MOV32ri 18
    $eax = MOV32ri 19
    $eax = MOV32ri 20
    $eax = MOV32ri 21
    $eax = MOV32ri 22
    $eax = MOV32ri 23
    $eax = MOV32ri 24
    $eax = MOV32ri 25
    $eax = MOV32ri 26
    RET64
---
# CHECK-LABEL: name: test_entry
# CHECK: bb.0:
# CHECK-NOT: CALL64pcrel32 @callee_small
# CHECK-DAG: $eax = MOV32ri 42
# CHECK-DAG: $ebx = MOV32ri 24
# CHECK: CALL64pcrel32 @callee_limit_26
name:            test_entry
tracksRegLiveness: true
body:             |
  bb.0:
    CALL64pcrel32 @callee_small, implicit $rsp, implicit $ssp
    CALL64pcrel32 @callee_limit_26, implicit $rsp, implicit $ssp
    RET64
---
# CHECK-LABEL: name: recursive_func
# CHECK: bb.0:
# CHECK: $ecx = INC32r
# CHECK-NEXT: CALL64pcrel32 @recursive_func
name:            recursive_func
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $ecx
    $ecx = INC32r $ecx, implicit-def $eflags
    CALL64pcrel32 @recursive_func, implicit $rsp, implicit $ssp, implicit $ecx
    RET64
---
# CHECK-LABEL: name: symbol_test
# CHECK: bb.0:
# CHECK-NOT: CALL64pcrel32 @callee_small
# CHECK: $eax = MOV32ri 42
name:            symbol_test
tracksRegLiveness: true
body:             |
  bb.0:
    CALL64pcrel32 @"callee_small", implicit $rsp, implicit $ssp
    RET64
---
name:            extra_filler_1
body:             |
  bb.0:
    $rax = MOV64ri 100
    $rbx = MOV64ri 200
    $rcx = MOV64ri 300
    RET64
---
name:            extra_filler_2
body:             |
  bb.0:
    $rdi = MOV64ri 1000
    $rsi = MOV64ri 2000
    $rdx = MOV64ri 3000
    $r8 = MOV64ri 4000
    $r9 = MOV64ri 5000
    RET64