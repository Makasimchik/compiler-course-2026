# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/rychkova_d_lab3_BACKEND%shlibext \
# RUN:     -run-pass=loop-unroll-limited \
# RUN:     %s -o - | FileCheck %s

--- |
  define void @test_3_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 3
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @test_5_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 5
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @test_7_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 7
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

---
name: test_3_iter
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    $ebx = MOV32ri 0
    JMP_1 %bb.1

  bb.1.loop:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $ecx = MOV32rr $ebx
    $ebx = ADD32ri8 $ebx, 1, implicit-def dead $eflags
    CMP32ri8 $ebx, 3, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2.exit:
    RET64

# CHECK-LABEL: name: test_3_iter
# CHECK: ADD32ri8
# CHECK-NOT: JCC_1 %bb.1

---
name: test_5_iter
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    $ebx = MOV32ri 0
    JMP_1 %bb.1

  bb.1.loop:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $ecx = MOV32rr $ebx
    $ebx = ADD32ri8 $ebx, 1, implicit-def dead $eflags
    CMP32ri8 $ebx, 5, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2.exit:
    RET64

# CHECK-LABEL: name: test_5_iter
# CHECK: ADD32ri8
# CHECK-NOT: JCC_1 %bb.1

---
name: test_7_iter
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    $ebx = MOV32ri 0
    JMP_1 %bb.1

  bb.1.loop:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $ecx = MOV32rr $ebx
    $ebx = ADD32ri8 $ebx, 1, implicit-def dead $eflags
    CMP32ri8 $ebx, 7, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2.exit:
    RET64

# CHECK-LABEL: name: test_7_iter
# CHECK: ADD32ri8
# CHECK: JCC_1 %bb.2
