# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/gonozov_l_lab_3_BACKEND%shlibext \
# RUN: -run-pass=example  %s -o - | FileCheck %s

# ============================================================
# TEST 1
# simple inline
# ============================================================

# CHECK: MOV32ri
# CHECK: ADD32ri
# CHECK-NOT: CALL64pcrel32 @foo

---
name: foo
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 5
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    RET64
...

--- 
name: main
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @foo
    RET64
...



# ============================================================
# TEST 2
# inline nested functions
# foo3 -> foo2 -> foo1
# ============================================================

# CHECK-LABEL: name: foo1
# CHECK: MOV32ri 1
# CHECK: ADD32ri
# CHECK: RET64

---
name: foo1
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 1
    %1:gr32 = ADD32ri %0, 7, implicit-def $eflags
    RET64
...

# CHECK-LABEL: name: foo2
# CHECK-NOT: CALL64pcrel32 @foo1
# CHECK: MOV32ri 1
# CHECK: ADD32ri
# CHECK: MOV32ri 9
# CHECK: SUB32ri
# CHECK: RET64

---
name: foo2
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @foo1
    %2:gr32 = MOV32ri 9
    %3:gr32 = SUB32ri %2, 3, implicit-def $eflags
    RET64
...

# CHECK-LABEL: name: foo3
# CHECK-NOT: CALL64pcrel32 @foo2
# CHECK-NOT: CALL64pcrel32 @foo1

# CHECK: MOV32ri 1
# CHECK: ADD32ri

# CHECK: MOV32ri 9
# CHECK: SUB32ri

# CHECK: XOR32rr
# CHECK: RET64

---
name: foo3
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @foo2
    %4:gr32 = XOR32rr %4, %4, implicit-def $eflags
    RET64
...

# ============================================================
# TEST 3
# recursive function
# depth <= 3 only
# some recursive call should remain
# ============================================================

# CHECK-LABEL: name: recfun
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri

# CHECK: CALL64pcrel32 @recfun

---
name: recfun
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 1
    CALL64pcrel32 @recfun
    RET64
...

# ============================================================
# TEST 4
# less 15 instructions => inline
# ============================================================

# CHECK-LABEL: name: caller15
# CHECK-NOT: CALL64pcrel32 @exact15
# CHECK: MOV32ri

---
name: exact15
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    RET64
...

---
name: caller15
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @exact15
    RET64
...

# ============================================================
# TEST 5
# 16 instructions => no inline
# ============================================================

# CHECK-LABEL: name: caller16
# CHECK: CALL64pcrel32 @too_big

---
name: too_big
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    %14:gr32 = MOV32ri 14
    %15:gr32 = MOV32ri 15
    RET64
...

---
name: caller16
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @too_big
    RET64
...

