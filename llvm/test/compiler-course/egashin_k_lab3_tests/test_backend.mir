# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/egashin_k_lab3_BACKEND%shlibext \
# RUN:   -run-pass=egashin-loop-unroll-x86 %s -o - | FileCheck %s

--- |
  target triple = "x86_64-pc-linux-gnu"

  define void @foo(i32) { ret void }
  define void @small_loop() { ret void }
  define void @big_loop() { ret void }
  define void @nested_inner_loop() { ret void }
...
---
name:            foo
frameInfo:
  adjustsStack:    false
body:             |
  bb.0:
    RET 0
...

# CHECK-LABEL: name: small_loop
# CHECK-COUNT-4: CALL64pcrel32 @foo
# CHECK-NOT: JMP_1 %bb.1
---
name:            small_loop
frameInfo:
  adjustsStack:    true
body:             |
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32r0 implicit-def dead $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 4, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# CHECK-LABEL: name: big_loop
# CHECK: CALL64pcrel32 @foo
# CHECK-NOT: CALL64pcrel32 @foo
# CHECK: JMP_1 %bb.1
---
name:            big_loop
frameInfo:
  adjustsStack:    true
body:             |
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32r0 implicit-def dead $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 7, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# CHECK-LABEL: name: nested_inner_loop
# CHECK-COUNT-2: CALL64pcrel32 @foo
# CHECK: JMP_1 %bb.1
---
name:            nested_inner_loop
frameInfo:
  adjustsStack:    true
body:             |
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32r0 implicit-def dead $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.4
    CMP32ri %0, 2, implicit-def $eflags
    JCC_1 %bb.4, 4, implicit killed $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.3, %bb.2
    %1:gr32 = MOV32r0 implicit-def dead $eflags
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %1:gr32 = ADD32ri8 %1, 1, implicit-def dead $eflags
    CMP32ri %1, 2, implicit-def $eflags
    JCC_1 %bb.3, 4, implicit killed $eflags
    JMP_1 %bb.2

  bb.3:
    successors: %bb.1
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    JMP_1 %bb.1

  bb.4:
    RET 0
...
