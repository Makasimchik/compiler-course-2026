# RUN: llc -mtriple=x86_64-unknown-linux-gnu --load=%llvmshlibdir/mityaeva_d_lab3_BACKEND%shlibext \
# RUN: -run-pass=mityaeva-d-lab3 %s -o - | FileCheck %s

--- |
  define void @nested_loop_test() {
  entry:
    br label %outer.header
  outer.header:
    br label %inner.setup
  inner.setup:
    br label %inner.header
  inner.header:
    br label %outer.latch
  outer.latch:
    br label %outer.header
  exit:
    ret void
  }
  define void @large_trip_count_test() {
  entry:
    br label %header
  header:
    br label %exit
  exit:
    ret void
  }
...
---
# CHECK-LABEL: name: nested_loop_test
# CHECK: bb.3.inner.header:
# CHECK-COUNT-2: $ebx = ADD32ri
# CHECK: bb.4.outer.latch:
# CHECK-COUNT-3: $eax = ADD32ri
name:            nested_loop_test
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    $eax = MOV32r0 implicit-def $eflags
    JMP_1 %bb.1
  bb.1.outer.header:
    liveins: $eax
    CMP32ri $eax, 3, implicit-def $eflags
    JCC_1 %bb.5, 13, implicit $eflags
    JMP_1 %bb.2
  bb.2.inner.setup:
    liveins: $eax
    $ebx = MOV32r0 implicit-def $eflags
    JMP_1 %bb.3
  bb.3.inner.header:
    liveins: $ebx
    $ebx = ADD32ri killed $ebx, 1, implicit-def $eflags
    CMP32ri $ebx, 2, implicit-def $eflags
    JCC_1 %bb.3, 12, implicit $eflags
    JMP_1 %bb.4
  bb.4.outer.latch:
    liveins: $eax
    $eax = ADD32ri killed $eax, 1, implicit-def $eflags
    JMP_1 %bb.1
  bb.5.exit:
    RET64
---
# CHECK-LABEL: name: large_trip_count_test
# CHECK: bb.1.header:
# CHECK: $eax = ADD32ri
# CHECK-NEXT: CMP32ri
# CHECK-NOT: $eax = ADD32ri
name:            large_trip_count_test
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0.entry:
    $eax = MOV32r0 implicit-def $eflags
    JMP_1 %bb.1
  bb.1.header:
    liveins: $eax
    $eax = ADD32ri killed $eax, 1, implicit-def $eflags
    CMP32ri $eax, 7, implicit-def $eflags
    JCC_1 %bb.1, 12, implicit $eflags
    JMP_1 %bb.2
  bb.2.exit:
    RET64