# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/rozenberg_a_lab3_BACKEND%shlibext \
# RUN: -run-pass=loop-unrolling-x86  %s -o - | FileCheck %s


--- |
  ; ModuleID = 'tests-opt.ll'
  source_filename = "tests.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"
  
  ; Function Attrs: noinline nounwind uwtable
  define dso_local i32 @test_simple_loop() #0 {
  entry:
    br label %for.cond
  
  for.cond:                                         ; preds = %for.body, %entry
    %i.0 = phi i32 [ 0, %entry ], [ %inc, %for.body ]
    %sum.0 = phi i32 [ 0, %entry ], [ %add, %for.body ]
    %cmp = icmp slt i32 %i.0, 4
    br i1 %cmp, label %for.body, label %for.end
  
  for.body:                                         ; preds = %for.cond
    %add = add nsw i32 %sum.0, %i.0
    %inc = add nsw i32 %i.0, 1
    br label %for.cond, !llvm.loop !6
  
  for.end:                                          ; preds = %for.cond
    ret i32 %sum.0
  }
  
  ; Function Attrs: noinline nounwind uwtable
  define dso_local i32 @test_boundary_loop() #0 {
  entry:
    br label %for.cond
  
  for.cond:                                         ; preds = %for.body, %entry
    %i.0 = phi i32 [ 0, %entry ], [ %inc, %for.body ]
    %product.0 = phi i32 [ 0, %entry ], [ %add, %for.body ]
    %cmp = icmp slt i32 %i.0, 5
    br i1 %cmp, label %for.body, label %for.end
  
  for.body:                                         ; preds = %for.cond
    %add = add nsw i32 %product.0, %i.0
    %inc = add nsw i32 %i.0, 1
    br label %for.cond, !llvm.loop !8
  
  for.end:                                          ; preds = %for.cond
    ret i32 %product.0
  }
  
  ; Function Attrs: noinline nounwind uwtable
  define dso_local i32 @test_too_large_loop() #0 {
  entry:
    br label %for.cond
  
  for.cond:                                         ; preds = %for.body, %entry
    %i.0 = phi i32 [ 0, %entry ], [ %inc, %for.body ]
    %sum.0 = phi i32 [ 0, %entry ], [ %add, %for.body ]
    %cmp = icmp slt i32 %i.0, 6
    br i1 %cmp, label %for.body, label %for.end
  
  for.body:                                         ; preds = %for.cond
    %mul = mul nsw i32 %i.0, %i.0
    %add = add nsw i32 %sum.0, %mul
    %inc = add nsw i32 %i.0, 1
    br label %for.cond, !llvm.loop !9
  
  for.end:                                          ; preds = %for.cond
    ret i32 %sum.0
  }
  
  ; Function Attrs: noinline nounwind uwtable
  define dso_local i32 @test_nested_loop() #0 {
  entry:
    br label %for.cond
  
  for.cond:                                         ; preds = %for.inc5, %entry
    %lsr.iv = phi i32 [ %lsr.iv.next, %for.inc5 ], [ 0, %entry ]
    %i.0 = phi i32 [ 0, %entry ], [ %inc6, %for.inc5 ]
    %s.0 = phi i32 [ 0, %entry ], [ %s.1, %for.inc5 ]
    %cmp = icmp slt i32 %i.0, 3
    br i1 %cmp, label %for.cond1.preheader, label %for.end7
  
  for.cond1.preheader:                              ; preds = %for.cond
    br label %for.cond1
  
  for.cond1:                                        ; preds = %for.body3, %for.cond1.preheader
    %j.0 = phi i32 [ %inc, %for.body3 ], [ 0, %for.cond1.preheader ]
    %s.1 = phi i32 [ %add4, %for.body3 ], [ %s.0, %for.cond1.preheader ]
    %cmp2 = icmp slt i32 %j.0, 4
    br i1 %cmp2, label %for.body3, label %for.inc5
  
  for.body3:                                        ; preds = %for.cond1
    %0 = add i32 %lsr.iv, %j.0
    %add4 = add nsw i32 %s.1, %0
    %inc = add nsw i32 %j.0, 1
    br label %for.cond1, !llvm.loop !10
  
  for.inc5:                                         ; preds = %for.cond1
    %inc6 = add nsw i32 %i.0, 1
    %lsr.iv.next = add nuw nsw i32 %lsr.iv, 10
    br label %for.cond, !llvm.loop !11
  
  for.end7:                                         ; preds = %for.cond
    ret i32 %s.0
  }
  
  ; Function Attrs: noinline nounwind uwtable
  define dso_local i32 @test_nested_partial() #0 {
  entry:
    br label %for.cond
  
  for.cond:                                         ; preds = %for.inc5, %entry
    %i.0 = phi i32 [ 0, %entry ], [ %inc6, %for.inc5 ]
    %s.0 = phi i32 [ 0, %entry ], [ %s.1, %for.inc5 ]
    %cmp = icmp slt i32 %i.0, 6
    br i1 %cmp, label %for.cond1.preheader, label %for.end7
  
  for.cond1.preheader:                              ; preds = %for.cond
    br label %for.cond1
  
  for.cond1:                                        ; preds = %for.body3, %for.cond1.preheader
    %j.0 = phi i32 [ %inc, %for.body3 ], [ 0, %for.cond1.preheader ]
    %s.1 = phi i32 [ %add4, %for.body3 ], [ %s.0, %for.cond1.preheader ]
    %cmp2 = icmp slt i32 %j.0, 3
    br i1 %cmp2, label %for.body3, label %for.inc5
  
  for.body3:                                        ; preds = %for.cond1
    %0 = add i32 %i.0, %j.0
    %add4 = add nsw i32 %s.1, %0
    %inc = add nsw i32 %j.0, 1
    br label %for.cond1, !llvm.loop !12
  
  for.inc5:                                         ; preds = %for.cond1
    %inc6 = add nsw i32 %i.0, 1
    br label %for.cond, !llvm.loop !13
  
  for.end7:                                         ; preds = %for.cond
    ret i32 %s.0
  }
  
  ; Function Attrs: noinline nounwind uwtable
  define dso_local i32 @test_triple_nested() #0 {
  entry:
    br label %for.cond
  
  for.cond:                                         ; preds = %for.inc13, %entry
    %lsr.iv = phi i32 [ %lsr.iv.next, %for.inc13 ], [ 0, %entry ]
    %i.0 = phi i32 [ 0, %entry ], [ %inc14, %for.inc13 ]
    %s.0 = phi i32 [ 0, %entry ], [ %s.1, %for.inc13 ]
    %cmp = icmp slt i32 %i.0, 2
    br i1 %cmp, label %for.cond1.preheader, label %for.end15
  
  for.cond1.preheader:                              ; preds = %for.cond
    br label %for.cond1
  
  for.cond1:                                        ; preds = %for.inc10, %for.cond1.preheader
    %lsr.iv1 = phi i32 [ %lsr.iv.next2, %for.inc10 ], [ %lsr.iv, %for.cond1.preheader ]
    %j.0 = phi i32 [ %inc11, %for.inc10 ], [ 0, %for.cond1.preheader ]
    %s.1 = phi i32 [ %s.2, %for.inc10 ], [ %s.0, %for.cond1.preheader ]
    %cmp2 = icmp slt i32 %j.0, 3
    br i1 %cmp2, label %for.cond4.preheader, label %for.inc13
  
  for.cond4.preheader:                              ; preds = %for.cond1
    br label %for.cond4
  
  for.cond4:                                        ; preds = %for.body6, %for.cond4.preheader
    %k.0 = phi i32 [ %inc, %for.body6 ], [ 0, %for.cond4.preheader ]
    %s.2 = phi i32 [ %add9, %for.body6 ], [ %s.1, %for.cond4.preheader ]
    %cmp5 = icmp slt i32 %k.0, 4
    br i1 %cmp5, label %for.body6, label %for.inc10
  
  for.body6:                                        ; preds = %for.cond4
    %0 = add i32 %lsr.iv1, %k.0
    %add9 = add nsw i32 %s.2, %0
    %inc = add nsw i32 %k.0, 1
    br label %for.cond4, !llvm.loop !14
  
  for.inc10:                                        ; preds = %for.cond4
    %inc11 = add nsw i32 %j.0, 1
    %lsr.iv.next2 = add nuw nsw i32 %lsr.iv1, 10
    br label %for.cond1, !llvm.loop !15
  
  for.inc13:                                        ; preds = %for.cond1
    %inc14 = add nsw i32 %i.0, 1
    %lsr.iv.next = add nuw nsw i32 %lsr.iv, 100
    br label %for.cond, !llvm.loop !16
  
  for.end15:                                        ; preds = %for.cond
    ret i32 %s.0
  }
  
  attributes #0 = { noinline nounwind uwtable "frame-pointer"="all" "min-legal-vector-width"="0" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="x86-64" "target-features"="+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87" "tune-cpu"="generic" }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 2}
  !5 = !{!"clang version 21.1.8 (https://github.com/ayzee7/compiler-course-2026.git 2c1342f24bdb4eb04aebcc7cd9935d0682552262)"}
  !6 = distinct !{!6, !7}
  !7 = !{!"llvm.loop.mustprogress"}
  !8 = distinct !{!8, !7}
  !9 = distinct !{!9, !7}
  !10 = distinct !{!10, !7}
  !11 = distinct !{!11, !7}
  !12 = distinct !{!12, !7}
  !13 = distinct !{!13, !7}
  !14 = distinct !{!14, !7}
  !15 = distinct !{!15, !7}
  !16 = distinct !{!16, !7}
...

# CHECK-LABEL: name: test_simple_loop
# CHECK-NOT: CMP32ri
# CHECK-NOT: JCC_1
# CHECK-NOT: INC32r
# CHECK-COUNT-4: MOV32ri {{[0-3]+}}
# CHECK-NOT: MOV32ri 4
# CHECK: $eax = COPY
# CHECK: RET

---
name:            test_simple_loop
alignment:       16
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   true
failsVerification: false
tracksDebugUserValues: true
registers:
  - { id: 0, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 1, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 2, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 3, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 4, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 5, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 6, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 7, class: gr32, preferred-register: '', flags: [  ] }
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
  
    %6:gr32 = MOV32r0 implicit-def dead $eflags
    %7:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1.for.cond:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    CMP32ri %6, 3, implicit-def $eflags
    JCC_1 %bb.3, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2.for.body:
    successors: %bb.1(0x80000000)
  
    %7:gr32 = nsw ADD32rr %7, %6, implicit-def dead $eflags
    %6:gr32 = nsw INC32r %6, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.3.for.end:
    $eax = COPY %7
    RET 0, killed $eax
...

