  - { id: 16, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 17, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 18, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 19, class: gr64_nosp, preferred-register: '', flags: [  ] }
  - { id: 20, class: gr64_with_sub_8bit, preferred-register: '', flags: [  ] }
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
