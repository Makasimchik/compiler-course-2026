body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
  
    undef %20.sub_32bit:gr64_with_sub_8bit = MOV32r0 implicit-def dead $eflags
    %15:gr32 = MOV32r0 implicit-def dead $eflags
    %18:gr32 = MOV32r0 implicit-def dead $eflags
  
