# RUN: llc -mtriple=x86_64-unknown-linux-gnu --load=%llvmshlibdir/eremin_v_lab_3_BACKEND%shlibext \
# RUN: -run-pass=inline-x86 %s -o - | FileCheck %s

--- |
  ; ModuleID = 'inline-test.ll'
  source_filename = "inline-test.cpp"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"

  define internal i32 @rec() {
    %v = call i32 @rec()
    %r = add i32 %v, 1
    ret i32 %r
  }

  define internal i32 @rec_big() {
    %v = call i32 @rec_big()
    %r = add i32 %v, 2
    ret i32 %r
  }

  define internal i32 @leaf() {
    ret i32 7
  }

  define internal i32 @caller() {
    %v = call i32 @leaf()
    %r = add i32 %v, 1
    ret i32 %r
  }

  define i32 @foo1(i32 %value) {
    %1 = mul i32 %value, %value
    ret i32 %1
  }

  define i32 @foo2(i32 %value) {
    %1 = add i32 %value, 10
    %2 = call i32 @foo1(i32 %value)
    %3 = sub i32 %1, %2
    ret i32 %3
  }

  define i32 @foo3(i32 %value) {
    %1 = call i32 @foo2(i32 %value)
    %2 = call i32 @foo1(i32 %1)
    %3 = mul i32 %1, %2
    ret i32 %3
  }

...
# CHECK-LABEL: name:            rec
# CHECK: MOV32ri 1
# CHECK: MOV32ri 1
# CHECK: MOV32ri 1
# CHECK: MOV32ri 1
# CHECK: CALL64pcrel32 @rec
name:            rec
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    renamable $eax = MOV32ri 1
    CALL64pcrel32 @rec, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
    RET 0, $eax

...
---
# CHECK-LABEL: name:            rec_big
# CHECK: CALL64pcrel32 @rec_big
name:            rec_big
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    renamable $eax = MOV32ri 1
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    CALL64pcrel32 @rec_big, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
    RET 0, $eax

...
---
# CHECK-LABEL: name:            leaf
# CHECK: MOV32ri 7
name:            leaf
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    renamable $eax = MOV32ri 7
    RET 0, $eax

...
---
# CHECK-LABEL: name:            caller
# CHECK: CALL64pcrel32 @leaf
# CHECK: ADD32ri8
name:            caller
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0:
    CALL64pcrel32 @leaf, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit-def $eax
    renamable $eax = ADD32ri8 killed renamable $eax, 1, implicit-def dead $eflags
    RET 0, $eax

...
---
# CHECK-LABEL: name:            foo1
name:            foo1
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0(%ir-block.0):
    liveins: $edi
    renamable $eax = COPY killed renamable $edi
    renamable $eax = IMUL32rr killed renamable $eax, renamable $eax, implicit-def dead $eflags
    RET 0, $eax

...
---
# CHECK-LABEL: name:            foo2
name:            foo2
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0(%ir-block.0):
    liveins: $edi
    renamable $ebx = COPY renamable $edi
    renamable $ebx = ADD32ri8 killed renamable $ebx, 10, implicit-def dead $eflags
    CALL64pcrel32 @foo1, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit $edi, implicit-def $eax
    renamable $ebx = SUB32rr killed renamable $ebx, killed renamable $eax, implicit-def dead $eflags
    renamable $eax = COPY killed renamable $ebx
    RET 0, $eax

...
---
# CHECK-LABEL: name:            foo3
name:            foo3
alignment:       16
tracksRegLiveness: true
body:             |
  bb.0(%ir-block.0):
    liveins: $edi
    CALL64pcrel32 @foo2, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit $edi, implicit-def $eax
    renamable $ebx = COPY renamable $eax
    $edi = COPY killed renamable $eax
    CALL64pcrel32 @foo1, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, implicit $edi, implicit-def $eax
    renamable $ebx = IMUL32rr killed renamable $ebx, killed renamable $eax, implicit-def dead $eflags
    renamable $eax = COPY killed renamable $ebx
    RET 0, $eax

...
