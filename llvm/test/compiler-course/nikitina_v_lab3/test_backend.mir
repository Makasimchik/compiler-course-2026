# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/nikitina_v_lab3_BACKEND%shlibext \
# RUN: -run-pass=null-check-backend %s -o - | FileCheck %s

# Source files

# test.cpp
#
# int readPtr(int* ptr) { return *ptr; }
# void writePtr(int* ptr, int val) { *ptr = val; }
# int doubleVal(int val) { return val * 2; }

# test.ll (-O2)
#
# define dso_local noundef i32 @_Z7readPtrPi(ptr noundef %0) local_unnamed_addr {
#   %2 = load i32, ptr %0, align 4
#   ret i32 %2
# }
#
# define dso_local void @_Z8writePtrPii(ptr noundef %0, i32 noundef %1) local_unnamed_addr {
#   store i32 %1, ptr %0, align 4
#   ret void
# }
#
# define dso_local noundef i32 @_Z9doubleVali(i32 noundef %0) local_unnamed_addr {
#   %2 = shl nsw i32 %0, 1
#   ret i32 %2
# }

---
|
  ; ModuleID = 'test.ll'
  source_filename = "test.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

  define dso_local noundef i32 @_Z7readPtrPi(ptr noundef %0) local_unnamed_addr {
    %2 = load i32, ptr %0, align 4
    ret i32 %2
  }

  define dso_local void @_Z8writePtrPii(ptr noundef %0, i32 noundef %1) local_unnamed_addr {
    store i32 %1, ptr %0, align 4
    ret void
  }

  define dso_local noundef i32 @_Z9doubleVali(i32 noundef %0) local_unnamed_addr {
    %2 = shl nsw i32 %0, 1
    ret i32 %2
  }
...
---
# CHECK-LABEL: name: _Z7readPtrPi
name: _Z7readPtrPi
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr64 }
  - { id: 1, class: gr32 }
liveins:
  - { reg: "$rdi", virtual-reg: "%0" }
body: |
  bb.0 (%ir-block.1):
    liveins: $rdi
    
    %0:gr64 = COPY $rdi
    
    ; CHECK: TEST64rr %0, %0
    ; CHECK-NEXT: JCC_1 %bb.1, 4
    
    ; CHECK: bb.2:
    ; CHECK-NEXT: %1:gr32 = MOV32rm %0, 1, $noreg, 0, $noreg :: (load (s32) from %ir.0)
    
    ; CHECK: bb.1:
    ; CHECK-NEXT: TRAP
    
    %1:gr32 = MOV32rm %0, 1, $noreg, 0, $noreg :: (load (s32) from %ir.0)
    $eax = COPY %1
    RET64 $eax

...
---
# CHECK-LABEL: name: _Z8writePtrPii
name: _Z8writePtrPii
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr64 }
  - { id: 1, class: gr32 }
liveins:
  - { reg: "$rdi", virtual-reg: "%0" }
  - { reg: "$esi", virtual-reg: "%1" }
body: |
  bb.0 (%ir-block.2):
    liveins: $rdi, $esi
    
    %0:gr64 = COPY $rdi
    %1:gr32 = COPY $esi
    
    ; CHECK: TEST64rr %0, %0
    ; CHECK-NEXT: JCC_1 %bb.1, 4
    
    ; CHECK: bb.2:
    ; CHECK-NEXT: MOV32mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s32) into %ir.0)
    
    ; CHECK: bb.1:
    ; CHECK-NEXT: TRAP
    
    MOV32mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s32) into %ir.0)
    RET64

...
---
# CHECK-LABEL: name: _Z9doubleVali
name: _Z9doubleVali
alignment: 16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
liveins:
  - { reg: "$edi", virtual-reg: "%0" }
body: |
  bb.0 (%ir-block.1):
    liveins: $edi
    
    %0:gr32 = COPY $edi
    
    ; CHECK-NOT: TEST64rr
    ; CHECK-NOT: TRAP
    ; CHECK: %1:gr32 = SHL32ri %0, 1, implicit-def dead $eflags
    
    %1:gr32 = SHL32ri %0, 1, implicit-def dead $eflags
    $eax = COPY %1
    RET64 $eax
...
