# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/dorofeev_i_backend_unroll_BACKEND%shlibext -run-pass=dorofeev-loop-unroll %s -o - | FileCheck %s

--- |
  define void @test_unroll_simple() { ret void }
  define void @test_no_unroll_limit() { ret void }
  define void @test_unroll_multi_inst() { ret void }
...
---
# ТЕСТ 1: Обычное разворачивание (итераций <= 5)
# CHECK-LABEL: name: test_unroll_simple
name:            test_unroll_simple
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gr32 = MOV32ri 0
  bb.1:
    ; У цикла 4 итерации (CMP = 4). Ожидаем 4 инструкции ADD.
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: CMP32ri8
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    CMP32ri8 %1, 4, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2
  bb.2:
    RET64
...
---
# ТЕСТ 2: Разворачивание НЕ выполняется (итераций > 5)
# CHECK-LABEL: name: test_no_unroll_limit
name:            test_no_unroll_limit
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gr32 = MOV32ri 0
  bb.1:
    ; TripCount = 10 (больше 5). По ТЗ плагин не должен трогать этот цикл.
    ; Ожидаем ровно одну инструкцию ADD (оригинал) и отсутствие копий.
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK-NOT: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: CMP32ri8
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    CMP32ri8 %1, 10, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2
  bb.2:
    RET64
...
---
# ТЕСТ 3: В цикле больше одной инструкции (add, sub, mul)
# CHECK-LABEL: name: test_unroll_multi_inst
name:            test_unroll_multi_inst
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gr32 = MOV32ri 0
  bb.1:
    ; TripCount = 3. Проверяем, что весь блок (ADD, SUB, IMUL) развернулся 3 раза.
    ; Итерация 1
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = SUB32ri
    ; CHECK: %{{[0-9]+}}:gr32 = IMUL32rri
    ; Итерация 2
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = SUB32ri
    ; CHECK: %{{[0-9]+}}:gr32 = IMUL32rri
    ; Итерация 3
    ; CHECK: %{{[0-9]+}}:gr32 = ADD32ri
    ; CHECK: %{{[0-9]+}}:gr32 = SUB32ri
    ; CHECK: %{{[0-9]+}}:gr32 = IMUL32rri
    ; CHECK: CMP32ri8
    
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    %2:gr32 = SUB32ri %1, 1, implicit-def $eflags
    %3:gr32 = IMUL32rri %2, 2, implicit-def $eflags
    CMP32ri8 %3, 3, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2
  bb.2:
    RET64