# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/volkov_a_lab3_BACKEND%shlibext -run-pass=volkov-a-inline %s -o - | FileCheck %s
--- |
  define i32 @add(i32 %a, i32 %b) {
    %sum = add i32 %a, %b
    ret i32 %sum
  }
  define i32 @small(i32 %x) {
    %a = add i32 %x, 1
    %b = add i32 %a, 2
    %c = add i32 %b, 3
    ret i32 %c
  }
  define i32 @large(i32 %x) {
    %1 = add i32 %x, 1
    %2 = add i32 %1, 2
    %3 = add i32 %2, 3
    %4 = add i32 %3, 4
    %5 = add i32 %4, 5
    %6 = add i32 %5, 6
    %7 = add i32 %6, 7
    %8 = add i32 %7, 8
    %9 = add i32 %8, 9
    %10 = add i32 %9, 10
    %11 = add i32 %10, 11
    %12 = add i32 %11, 12
    %13 = add i32 %12, 13
    %14 = add i32 %13, 14
    %15 = add i32 %14, 15
    %16 = add i32 %15, 16
    ret i32 %16
  }
  define i32 @factorial(i32 %n) {
    %cmp = icmp sle i32 %n, 1
    br i1 %cmp, label %end, label %rec
  end:
    ret i32 1
  rec:
    %sub = sub i32 %n, 1
    %call = call i32 @factorial(i32 %sub)
    %mul = mul i32 %n, %call
    ret i32 %mul
  }
  define i32 @main() {
    %r1 = call i32 @add(i32 10, i32 20)
    %r2 = call i32 @small(i32 1)
    %r3 = call i32 @large(i32 3)
    %r4 = call i32 @factorial(i32 4)
    %res = add i32 %r1, %r2
    %res2 = add i32 %res, %r3
    %final = add i32 %res2, %r4
    ret i32 %final
  }
  define i32 @foo1(i32 %value) {
    %1 = mul i32 %value, %value
    ret i32 %1
  }
  define i32 @foo2(i32 %value) {
    %1 = add i32 %value, 10
    %2 = call i32 @foo1(i32 %value)
    %3 = sub i32 %1, %2
    ret i32 %3
  }
  define i32 @foo3(i32 %value) {
    %1 = call i32 @foo2(i32 %value)
    %2 = call i32 @foo1(i32 %1)
    %3 = mul i32 %1, %2
    ret i32 %3
  }
...
# CHECK-LABEL: name: main
---
name: main
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK: %0:gr32 = MOV32ri 10
    ; CHECK: %1:gr32 = MOV32ri 20
    ; CHECK: %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    ; CHECK: %3:gr32 = MOV32ri 1
    ; CHECK: %4:gr32 = ADD32ri %3, 1, implicit-def dead $eflags
    ; CHECK: %5:gr32 = ADD32ri %4, 2, implicit-def dead $eflags
    ; CHECK: %6:gr32 = ADD32ri %5, 3, implicit-def dead $eflags
    ; CHECK: %7:gr32 = MOV32ri 3
    ; CHECK: CALL64pcrel32 @large
    ; CHECK: %8:gr32 = COPY $eax
    ; CHECK: %9:gr32 = MOV32ri 4
    ; CHECK: CALL64pcrel32 @factorial
    ; CHECK: %10:gr32 = COPY $eax

    %0:gr32 = MOV32ri 10
    %1:gr32 = MOV32ri 20
    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    %3:gr32 = MOV32ri 1
    %4:gr32 = ADD32ri %3, 1, implicit-def dead $eflags
    %5:gr32 = ADD32ri %4, 2, implicit-def dead $eflags
    %6:gr32 = ADD32ri %5, 3, implicit-def dead $eflags
    %7:gr32 = MOV32ri 3
    CALL64pcrel32 @large, csr_64, implicit $sp, implicit $ssp, implicit-def $eax
    %8:gr32 = COPY $eax
    %9:gr32 = MOV32ri 4
    CALL64pcrel32 @factorial, csr_64, implicit $sp, implicit $ssp, implicit-def $eax
    %10:gr32 = COPY $eax
    %11:gr32 = ADD32rr %2, %6, implicit-def dead $eflags
    %12:gr32 = ADD32rr %11, %8, implicit-def dead $eflags
    %13:gr32 = ADD32rr %12, %10, implicit-def dead $eflags
    $eax = COPY %13
    RET 0, implicit $eax
...
---
name: foo1
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = IMUL32rr %0, %0, implicit-def dead $eflags
    $eax = COPY %1
    RET 0, implicit $eax
...
---
name: foo2
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = ADD32ri %0, 10, implicit-def dead $eflags
    $edi = COPY %0
    CALL64pcrel32 @foo1, csr_64, implicit $sp, implicit $ssp, implicit-def $eax
    %2:gr32 = COPY $eax
    %3:gr32 = SUB32rr %1, %2, implicit-def dead $eflags
    $eax = COPY %3
    RET 0, implicit $eax
...
# CHECK-LABEL: name: foo3
# убеждаемся, что вызовов не осталось, а инструкции заинлайнились в нужном порядке
# CHECK: bb.0:
# CHECK-NOT: CALL64pcrel32
# CHECK: %3:gr32 = IMUL32rr %1, %2
# CHECK: RET 0
---
name: foo3
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    
    $edi = COPY %0
    CALL64pcrel32 @foo2, csr_64, implicit $sp, implicit $ssp, implicit-def $eax
    %1:gr32 = COPY $eax
    
    $edi = COPY %1
    CALL64pcrel32 @foo1, csr_64, implicit $sp, implicit $ssp, implicit-def $eax
    %2:gr32 = COPY $eax
    
    %3:gr32 = IMUL32rr %1, %2, implicit-def dead $eflags
    $eax = COPY %3
    RET 0, implicit $eax