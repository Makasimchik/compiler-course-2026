# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/zavyalov_a_lab3_BACKEND%shlibext \
# RUN:     -run-pass=loop-unroll-x86 \
# RUN:     %s -o - | FileCheck %s

--- |
  ; ModuleID = 'test_opt.ll'
  source_filename = "test.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-pc-linux-gnu"
  
  define dso_local void @foo(i32 noundef %0) {
    ret void
  }
  
  define dso_local void @bar(i32 noundef %0) {
    ret void
  }
  
  define dso_local void @no_loop_to_unroll() {
    %1 = add nsw i32 undef, 1
    ret void
  }
  
  define dso_local void @simple_unroll() {
    br label %1
  
  1:                                                ; preds = %3, %0
    %.0 = phi i32 [ 0, %0 ], [ %4, %3 ]
    %2 = icmp slt i32 %.0, 4
    br i1 %2, label %3, label %5
  
  3:                                                ; preds = %1
    call void @foo(i32 noundef %.0)
    %4 = add nsw i32 %.0, 1
    br label %1, !llvm.loop !6
  
  5:                                                ; preds = %1
    ret void
  }
  
  define dso_local void @bigger_unroll() {
    br label %1
  
  1:                                                ; preds = %3, %0
    %.0 = phi i32 [ 0, %0 ], [ %4, %3 ]
    %2 = icmp slt i32 %.0, 10
    br i1 %2, label %3, label %5
  
  3:                                                ; preds = %1
    call void @foo(i32 noundef %.0)
    %4 = add nsw i32 %.0, 1
    br label %1, !llvm.loop !8
  
  5:                                                ; preds = %1
    ret void
  }
  
  define dso_local void @simple_unroll_with_two_functions() {
    br label %1
  
  1:                                                ; preds = %3, %0
    %.0 = phi i32 [ 0, %0 ], [ %4, %3 ]
    %2 = icmp slt i32 %.0, 3
    br i1 %2, label %3, label %5
  
  3:                                                ; preds = %1
    call void @foo(i32 noundef %.0)
    call void @bar(i32 noundef %.0)
    %4 = add nsw i32 %.0, 1
    br label %1, !llvm.loop !9
  
  5:                                                ; preds = %1
    ret void
  }
  
  define dso_local void @nested_loop_both_unrollable() {
    br label %1
  
  1:                                                ; preds = %8, %0
    %.0 = phi i32 [ 0, %0 ], [ %9, %8 ]
    %2 = icmp slt i32 %.0, 2
    br i1 %2, label %.preheader, label %10
  
  .preheader:                                       ; preds = %1
    br label %3
  
  3:                                                ; preds = %5, %.preheader
    %.01 = phi i32 [ %7, %5 ], [ 0, %.preheader ]
    %4 = icmp slt i32 %.01, 2
    br i1 %4, label %5, label %8
  
  5:                                                ; preds = %3
    %6 = add i32 %.0, %.01
    call void @foo(i32 noundef %6)
    %7 = add nsw i32 %.01, 1
    br label %3, !llvm.loop !10
  
  8:                                                ; preds = %3
    %9 = add nsw i32 %.0, 1
    br label %1, !llvm.loop !11
  
  10:                                               ; preds = %1
    ret void
  }
  
  define dso_local void @nested_loop_only_outer_unrollable() {
    br label %1
  
  1:                                                ; preds = %8, %0
    %.0 = phi i32 [ 0, %0 ], [ %9, %8 ]
    %2 = icmp slt i32 %.0, 2
    br i1 %2, label %.preheader, label %10
  
  .preheader:                                       ; preds = %1
    br label %3
  
  3:                                                ; preds = %5, %.preheader
    %.01 = phi i32 [ %7, %5 ], [ 0, %.preheader ]
    %4 = icmp slt i32 %.01, 7
    br i1 %4, label %5, label %8
  
  5:                                                ; preds = %3
    %6 = add i32 %.0, %.01
    call void @foo(i32 noundef %6)
    %7 = add nsw i32 %.01, 1
    br label %3, !llvm.loop !12
  
  8:                                                ; preds = %3
    %9 = add nsw i32 %.0, 1
    br label %1, !llvm.loop !13
  
  10:                                               ; preds = %1
    ret void
  }
  
  define dso_local void @nested_loop_only_inner_unrollable() {
    br label %1
  
  1:                                                ; preds = %8, %0
    %.0 = phi i32 [ 0, %0 ], [ %9, %8 ]
    %2 = icmp slt i32 %.0, 7
    br i1 %2, label %.preheader, label %10
  
  .preheader:                                       ; preds = %1
    br label %3
  
  3:                                                ; preds = %5, %.preheader
    %.01 = phi i32 [ %7, %5 ], [ 0, %.preheader ]
    %4 = icmp slt i32 %.01, 2
    br i1 %4, label %5, label %8
  
  5:                                                ; preds = %3
    %6 = add i32 %.0, %.01
    call void @foo(i32 noundef %6)
    %7 = add nsw i32 %.01, 1
    br label %3, !llvm.loop !14
  
  8:                                                ; preds = %3
    %9 = add nsw i32 %.0, 1
    br label %1, !llvm.loop !15
  
  10:                                               ; preds = %1
    ret void
  }
  
  define dso_local i32 @main() {
    ret i32 0
  }
  
  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}
  
  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 2}
  !5 = !{!"Ubuntu clang version 18.1.3 (1ubuntu1)"}
  !6 = distinct !{!6, !7}
  !7 = !{!"llvm.loop.mustprogress"}
  !8 = distinct !{!8, !7}
  !9 = distinct !{!9, !7}
  !10 = distinct !{!10, !7}
  !11 = distinct !{!11, !7}
  !12 = distinct !{!12, !7}
  !13 = distinct !{!13, !7}
  !14 = distinct !{!14, !7}
  !15 = distinct !{!15, !7}
...

---
name:            foo
frameInfo:
  adjustsStack:    false
body:             |
  bb.0 (%ir-block.1):
    RET 0
...

---
name:            bar
frameInfo:
  adjustsStack:    false
body:             |
  bb.0 (%ir-block.1):
    RET 0
...

# Тест 0. Функция без циклов для развертывания
# Проверяет, что пасс корректно обрабатывает функции, не содержащие циклов. Ожидается, что функция останется без изменений и не вызовет ошибок.
# CHECK-LABEL: name: no_loop_to_unroll
# CHECK: bb.0 (%ir-block.0):
# CHECK-NEXT: RET 0
---
name:            no_loop_to_unroll
frameInfo:
  adjustsStack:    false
body:             |
  bb.0 (%ir-block.0):
    RET 0
...

# Тест 1. Простое развертывание цикла
# Проверяет, что цикл с 4 итерациями успешно разворачивается. Ожидается 4 вызова функции foo.
# CHECK-LABEL: name: simple_unroll
# CHECK-COUNT-4: CALL64pcrel32 @foo
---
name:            simple_unroll
frameInfo:
  adjustsStack:    true
body:             |
  bb.0 (%ir-block.0):
    successors: %bb.1(0x80000000)
  
    %4:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.1):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    CMP32ri %4, 3, implicit-def $eflags
    JCC_1 %bb.3, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2 (%ir-block.3):
    successors: %bb.1(0x80000000)
  
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %4
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %4:gr32 = nsw INC32r %4, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.3 (%ir-block.5):
    RET 0
...

# Тест 2. Развертывание цикла большего размера
# Проверяет, что цикл с 10 итерациями разворачивается с максимальным числом итераций (5). Ожидается 5 вызовов foo, а не 10.
# CHECK-LABEL: name: bigger_unroll
# CHECK-COUNT-5: CALL64pcrel32 @foo
---
name:            bigger_unroll
frameInfo:
  adjustsStack:    true
body:             |
  bb.0 (%ir-block.0):
    successors: %bb.1(0x80000000)
  
    %4:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.1):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    CMP32ri %4, 9, implicit-def $eflags
    JCC_1 %bb.3, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2 (%ir-block.3):
    successors: %bb.1(0x80000000)
  
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %4
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %4:gr32 = nsw INC32r %4, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.3 (%ir-block.5):
    RET 0
...

# Тест 3. Развертывание цикла с двумя функциями в теле
# Проверяет, что цикл с 3 итерациями успешно разворачивается. На каждой итерации вызываются функции foo и bar. Ожидается 3 вызова foo и 3 вызова bar после развертывания.
# CHECK-LABEL: name: simple_unroll_with_two_functions
# CHECK-COUNT-1: CALL64pcrel32 @foo
# CHECK-COUNT-1: CALL64pcrel32 @bar
# CHECK-COUNT-1: CALL64pcrel32 @foo
# CHECK-COUNT-1: CALL64pcrel32 @bar
# CHECK-COUNT-1: CALL64pcrel32 @foo
# CHECK-COUNT-1: CALL64pcrel32 @bar
---
name:            simple_unroll_with_two_functions
frameInfo:
  adjustsStack:    true
body:             |
  bb.0 (%ir-block.0):
    successors: %bb.1(0x80000000)
  
    %4:gr32 = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.1):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
  
    CMP32ri %4, 2, implicit-def $eflags
    JCC_1 %bb.3, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2 (%ir-block.3):
    successors: %bb.1(0x80000000)
  
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %4
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %4
    CALL64pcrel32 @bar, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %4:gr32 = nsw INC32r %4, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.3 (%ir-block.5):
    RET 0
...

# Тест 4. Развертывание двух циклов, один из них вложенный
# Проверяет развертывание обоих циклов во вложенной структуре (2×2 итерации). Ожидается 4 вызова foo.
# CHECK-LABEL: name: nested_loop_both_unrollable
# CHECK-COUNT-4: CALL64pcrel32 @foo
---
name:            nested_loop_both_unrollable
frameInfo:
  adjustsStack:    true
body:             |
  bb.0 (%ir-block.0):
    successors: %bb.1(0x80000000)
  
    undef %12.sub_32bit:gr64_with_sub_8bit = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.1):
    successors: %bb.2(0x7c000000), %bb.6(0x04000000)
  
    CMP32ri %12.sub_32bit, 1, implicit-def $eflags
    JCC_1 %bb.6, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    undef %11.sub_32bit:gr64_nosp = MOV32r0 implicit-def dead $eflags
  
  bb.3 (%ir-block.3):
    successors: %bb.4(0x7c000000), %bb.5(0x04000000)
  
    CMP32ri %11.sub_32bit, 1, implicit-def $eflags
    JCC_1 %bb.5, 15, implicit killed $eflags
    JMP_1 %bb.4
  
  bb.4 (%ir-block.5):
    successors: %bb.3(0x80000000)
  
    %8:gr32 = LEA64_32r %12, 1, %11, 0, $noreg
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %8
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %11.sub_32bit:gr64_nosp = nsw INC32r %11.sub_32bit, implicit-def dead $eflags
    JMP_1 %bb.3
  
  bb.5 (%ir-block.8):
    successors: %bb.1(0x80000000)
  
    %12.sub_32bit:gr64_with_sub_8bit = nsw INC32r %12.sub_32bit, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.6 (%ir-block.10):
    RET 0
...

# Тест 5. Развертывание только внешнего цикла
# Проверяет, что разворачивается только внешний цикл (2 итерации), а внутренний (7 итераций) остаётся без изменений. Ожидается 2 вызова foo.
# CHECK-LABEL: name: nested_loop_only_outer_unrollable
# CHECK-COUNT-2: CALL64pcrel32 @foo
---
name:            nested_loop_only_outer_unrollable
frameInfo:
  adjustsStack:    true
body:             |
  bb.0 (%ir-block.0):
    successors: %bb.1(0x80000000)
  
    undef %12.sub_32bit:gr64_with_sub_8bit = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.1):
    successors: %bb.2(0x7c000000), %bb.6(0x04000000)
  
    CMP32ri %12.sub_32bit, 1, implicit-def $eflags
    JCC_1 %bb.6, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    undef %11.sub_32bit:gr64_nosp = MOV32r0 implicit-def dead $eflags
  
  bb.3 (%ir-block.3):
    successors: %bb.4(0x7c000000), %bb.5(0x04000000)
  
    CMP32ri %11.sub_32bit, 6, implicit-def $eflags
    JCC_1 %bb.5, 15, implicit killed $eflags
    JMP_1 %bb.4
  
  bb.4 (%ir-block.5):
    successors: %bb.3(0x80000000)
  
    %8:gr32 = LEA64_32r %12, 1, %11, 0, $noreg
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %8
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %11.sub_32bit:gr64_nosp = nsw INC32r %11.sub_32bit, implicit-def dead $eflags
    JMP_1 %bb.3
  
  bb.5 (%ir-block.8):
    successors: %bb.1(0x80000000)
  
    %12.sub_32bit:gr64_with_sub_8bit = nsw INC32r %12.sub_32bit, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.6 (%ir-block.10):
    RET 0
...

# Тест 6. Развертывание только внутреннего цикла
# Проверяет, что разворачивается только внутренний цикл (2 итерации), а внешний (7 итераций) остаётся без изменений. Ожидается 2 вызова foo.
# CHECK-LABEL: name: nested_loop_only_inner_unrollable
# CHECK-COUNT-2: CALL64pcrel32 @foo
---
name:            nested_loop_only_inner_unrollable

frameInfo:
  adjustsStack:    true

body:             |
  bb.0 (%ir-block.0):
    successors: %bb.1(0x80000000)
  
    undef %12.sub_32bit:gr64_with_sub_8bit = MOV32r0 implicit-def dead $eflags
  
  bb.1 (%ir-block.1):
    successors: %bb.2(0x7c000000), %bb.6(0x04000000)
  
    CMP32ri %12.sub_32bit, 6, implicit-def $eflags
    JCC_1 %bb.6, 15, implicit killed $eflags
    JMP_1 %bb.2
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    undef %11.sub_32bit:gr64_nosp = MOV32r0 implicit-def dead $eflags
  
  bb.3 (%ir-block.3):
    successors: %bb.4(0x7c000000), %bb.5(0x04000000)
  
    CMP32ri %11.sub_32bit, 1, implicit-def $eflags
    JCC_1 %bb.5, 15, implicit killed $eflags
    JMP_1 %bb.4
  
  bb.4 (%ir-block.5):
    successors: %bb.3(0x80000000)
  
    %8:gr32 = LEA64_32r %12, 1, %11, 0, $noreg
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %8
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %11.sub_32bit:gr64_nosp = nsw INC32r %11.sub_32bit, implicit-def dead $eflags
    JMP_1 %bb.3
  
  bb.5 (%ir-block.8):
    successors: %bb.1(0x80000000)
  
    %12.sub_32bit:gr64_with_sub_8bit = nsw INC32r %12.sub_32bit, implicit-def dead $eflags
    JMP_1 %bb.1
  
  bb.6 (%ir-block.10):
    RET 0
...
---
name:            main

frameInfo:

  adjustsStack:    false


body:             |
  bb.0 (%ir-block.0):
    $eax = MOV32r0 implicit-def dead $eflags
    RET 0, killed $eax
...
