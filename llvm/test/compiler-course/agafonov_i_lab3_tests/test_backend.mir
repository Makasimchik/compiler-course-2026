# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/agafonov_i_lab3_BACKEND%shlibext \
# RUN: -run-pass=null-check-x86 %s -o - | FileCheck %s
--- |
  define void @test_64bit_load(ptr %p) { ret void }
  define void @test_32bit_load(ptr %p) { ret void }
  define void @test_store(ptr %p, i64 %v) { ret void }
  define void @test_exclusions() { ret void }
  define void @test_no_mem() { ret void }
  define void @test_two_regs(ptr %a, ptr %b) { ret void }
...
---
# CHECK-LABEL: name: test_64bit_load
# CHECK:      $rax = MOV64rm $rdi
# CHECK-NEXT: TEST64rr $rdi, $rdi, implicit-def $eflags
# CHECK-NEXT: JCC_1 %bb.1, 4, implicit $eflags
# CHECK:      TRAP
name:            test_64bit_load
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi
    $rax = MOV64rm $rdi, 1, $noreg, 0, $noreg
    RET 0
...
---
# CHECK-LABEL: name: test_32bit_load
# CHECK:      $eax = MOV32rm $rsi
# CHECK-NEXT: TEST64rr $rsi, $rsi, implicit-def $eflags
# CHECK-NEXT: JCC_1 %bb.1, 4, implicit $eflags
# CHECK:      TRAP
name:            test_32bit_load
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rsi
    $eax = MOV32rm $rsi, 1, $noreg, 0, $noreg
    RET 0
...
---
# CHECK-LABEL: name: test_store
# CHECK:      MOV64mr $rdi, 1, $noreg, 0, $noreg, $rsi
# CHECK-NEXT: TEST64rr $rdi, $rdi, implicit-def $eflags
# CHECK-NEXT: JCC_1 %bb.1, 4, implicit $eflags
# CHECK:      TRAP
name:            test_store
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi, $rsi
    MOV64mr $rdi, 1, $noreg, 0, $noreg, $rsi
    RET 0
...
---
# CHECK-LABEL: name: test_exclusions
# CHECK-NOT:  TEST64rr
# CHECK-NOT:  TEST32rr
# CHECK:      RET 0
name:            test_exclusions
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rsp, $rbp
    $rax = MOV64rm $rsp, 1, $noreg, 8, $noreg
    $rbx = MOV64rm $rbp, 1, $noreg, -8, $noreg
    RET 0
...
---
# CHECK-LABEL: name: test_no_mem
# CHECK-NOT:  TEST64rr
# CHECK:      COPY
name:            test_no_mem
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rax, $rbx
    $rax = COPY $rbx
    RET 0
...
---
# CHECK-LABEL: name: test_two_regs
# CHECK:      TEST64rr $rdi, $rdi
# CHECK:      TEST64rr $rsi, $rsi
# CHECK:      TRAP
name:            test_two_regs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $rdi, $rsi
    $rax = MOV64rm $rdi, 1, $noreg, 0, $noreg
    $rcx = MOV64rm $rsi, 1, $noreg, 0, $noreg
    RET 0